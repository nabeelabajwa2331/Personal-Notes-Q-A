# Required authentication settings
# Use at least 8 characters; 16 or more is recommended.
APP_PASSWORD=replace-with-a-strong-password

# Signing key for session cookies. Use a long random value (32+ characters).
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value

# Encrypts exported backups. Keep this separate from APP_PASSWORD.
BACKUP_PASSWORD=replace-with-a-separate-backup-password

# Optional
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=true
# APP_ORIGIN=https://notes.example.com
# DATABASE_URL=postgresql://user:password@host:5432/personal_notes
# DATABASE_SSL=true
