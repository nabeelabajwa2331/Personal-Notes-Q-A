    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
